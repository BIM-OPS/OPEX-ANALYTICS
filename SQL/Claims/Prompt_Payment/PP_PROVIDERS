 from "CSR"."PV_AGREEMENT" "A" LEFT OUTER JOIN "CSR"."SY_SYS_CODE" "SS" on "A"."SFDA_STATUS"=trim(both
 from "SS"."SYS_CODE") and 'SFDA_STATUS'=trim(both
 from "SS"."SYS_TYPE")) 
select trim(both
 from "PV_PROVIDER2"."PROV_CODE") "Provider_Code", "PV_AGREEMENT3"."PERIOD_FROM" "Period_From", "PV_AGREEMENT3"."PERIOD_TO" "Period_To", sum("PV_AGREE_PP"."PROMPT_PAY_PERIOD") "PP_Period"
 from ("PV_PROVIDER2" INNER JOIN "PV_AGREEMENT3" on "PV_PROVIDER2"."PROV_CODE"="PV_AGREEMENT3"."PROV_CODE") LEFT OUTER JOIN "CSR"."PV_AGREE_PP" "PV_AGREE_PP" on "PV_AGREEMENT3"."AGREE_ID"="PV_AGREE_PP"."AGREE_ID"
 where "PV_AGREEMENT3"."PERIOD_FROM" between DATE '2023-01-01' and TRUNC( CURRENT_DATE )
 group by trim(both
 from "PV_PROVIDER2"."PROV_CODE"), "PV_AGREEMENT3"."PERIOD_FROM", "PV_AGREEMENT3"."PERIOD_TO"
