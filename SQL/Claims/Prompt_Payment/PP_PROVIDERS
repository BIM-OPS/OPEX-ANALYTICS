with "PV_PROVIDER2" as (
select "PV_PROVIDER"."PROV_CODE"
 from (((((("CSR"."PV_PROVIDER" "PV_PROVIDER" INNER JOIN "CSR"."DC_DISTRICT" "DC_DISTRICT" on "PV_PROVIDER"."CORR_DIST_CODE"="DC_DISTRICT"."DIST_CODE") LEFT OUTER JOIN "CSR"."SY_PROVIDER_LEVEL" "SY_PROVIDER_LEVEL1" on "PV_PROVIDER"."PROV_LEVEL"="SY_PROVIDER_LEVEL1"."SYS_CODE") LEFT OUTER JOIN "CSR"."SY_PRACTICE_TYPE" "SY_PRACTICE_TYPE" on "PV_PROVIDER"."PRACTICE_TYPE"="SY_PRACTICE_TYPE"."SYS_CODE") LEFT OUTER JOIN "CSR"."PV_PROV_LVL_MVMNT" on "PV_PROVIDER"."PROV_CODE"="PV_PROV_LVL_MVMNT"."PROV_CODE") LEFT OUTER JOIN "CSR"."SY_PROVIDER_LEVEL" "SY_PROVIDER_LEVEL2" on "PV_PROV_LVL_MVMNT"."PROV_LEVEL"="SY_PROVIDER_LEVEL2"."SYS_CODE") LEFT OUTER JOIN "CSR"."SY_SYS_CODE" "VRS" on "PV_PROVIDER"."VAT_REG_STATUS"=trim(both
