Sent to Finance (Non DHS) = CALCULATE(
    MIN('CALENDAR'[Date]),
    FILTER(
        'CALENDAR',
        'CALENDAR'[Date] > 'Data Source'[Create Date] && 'CALENDAR'[If work day] = 1
    )
)

Finance Efficiency Non DHS = IF( NOT(ISBLANK('Data Source'[STOP Batches dummay])), "Finance Processing within 6 days",IF(ISBLANK('Data Source'[Payment Date]),"Finance Exceeding 6 days",IF(NETWORKDAYS('Data Source'[Sent to Finance (Non DHS)],'Data Source'[Payment Date],7,'Eids Vacation')<=6,"Finance Processing within 6 days","Finance Exceeding 6 days")))
Claims Efficiency Non_DHS = IF(ISBLANK('Data Source'[Batch Received Date]),BLANK(),IF(NETWORKDAYS('Data Source'[Batch Received Date],'Data Source'[Create Date],7,'Eids Vacation')<=4,"Claims Processing within 4 days","Claims Exceeding 4 days"))
Sent to Finance (DHS) = VAR StartDate = 'Data Source'[Batch Received Date]
Var bussiness = FILTER('CALENDAR','CALENDAR'[Date] >  StartDate && 'CALENDAR'[If work day] = 1 )
 
return
MAXX(TOPN(2,bussiness,'CALENDAR'[Date],ASC),'CALENDAR'[Date])
Var bussiness = FILTER('CALENDAR','CALENDAR'[Date] >  StartDate && 'CALENDAR'[If work day] = 1 )
 
return
MAXX(TOPN(2,bussiness,'CALENDAR'[Date],ASC),'CALENDAR'[Date])


Finance Efficiency DHS = IF( NOT(ISBLANK('Data Source'[STOP Batches dummay])),"Finance Processing within 7 days",IF(ISBLANK('Data Source'[Payment Date]),"Finance Exceeding 7 days",IF(NETWORKDAYS('Data Source'[Sent to Finance (DHS)],'Data Source'[Payment Date],7,'Eids Vacation')<=7,"Finance Processing within 7 days","Finance Exceeding 7 days")))

Claims Efficiency DHS = IF(ISBLANK('Data Source'[Batch Received Date]),"Claims ",IF(NETWORKDAYS('Data Source'[Batch Received Date],'Data Source'[Create Date],7,'Eids Vacation')<=3,"Claims Processing within 3 days","Claims Exceeding 3 days"))


Over all 2 = 
VAR ProviderID='Data Source'[Provider Code]
VAR PaymentDate='Data Source'[Payment Date]
VAR BatchReceivedDate='Data Source'[Batch Received Date]
VAR WorkingDays=IF(ISBLANK(PaymentDate),NETWORKDAYS(BatchReceivedDate,TODAY(),7,'Eids Vacation'),NETWORKDAYS(BatchReceivedDate,PaymentDate,7,'Eids Vacation'))
RETURN
IF('Data Source'[TYPE] = "NO PP","No pp",IF(NOT(ISBLANK('Data Source'[Exculde_Providers]))|| NOT(ISBLANK('Data Source'[STOP Batches dummay])),"Within",
IF(WorkingDays <='Data Source'[PP agreement],"Within","Late")))

PP agreement = 
    
VAR ProviderID = 'Data Source'[Provider Code]
VAR BatchReceivedDate = 'Data Source'[Date of Batch]
VAR FilteredTable =
    FILTER(
        'Contactiong-%',
        'Contactiong-%'[PROVIDER Details] = ProviderID &&
        'Contactiong-%'[PP Period From] <= BatchReceivedDate &&
        (
            ISBLANK('Contactiong-%'[PP Period To]) || 
            'Contactiong-%'[PP Period To] > BatchReceivedDate
        )
    )
VAR CustomThreshold = MAXX(FilteredTable, 'Contactiong-%'[PP Period])

RETURN
  IF(ISBLANK(CustomThreshold),BLANK(), CustomThreshold)

TYPE = IF(ISBLANK('Data Source'[PP agreement]), "NO PP", CONCATENATE("", 'Data Source'[PP agreement]))
